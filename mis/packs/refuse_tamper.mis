module HuggingfaceSyncBridgeRefuseTamper {

  invariant letter_hash_bound: letter_hash_root != @0;
  invariant deep_root_moniversive: deep_root == moniversive;
  invariant settlement_chain: chain_id == 1202;
  invariant settlement_network_clrty1: settlement_network == clrty_1;
  invariant kernel_is_misc: compiler_kernel == misc;
  invariant pack_refuse_tamper_bound: pack_bound == true;
  invariant catalog_backlink: mis_catalog_bound == true;

  invariant refuse_tamper_081: refuse_tamper_081_bound == true;
  invariant refuse_tamper_082: refuse_tamper_082_bound == true;
  invariant refuse_tamper_083: refuse_tamper_083_bound == true;
